cabal-version:      3.0
name:               buildr
version:            0.1.0.0
synopsis:           A compilation renderer and build front-end for Haskell
description:
    buildr is a high-performance build front-end and visual compilation interface
    for Haskell (GHC 9.10+ and cabal-install). It replaces traditional wall-of-text
    compiler output with live interactive dependency frontiers, 20-cell progress
    metrics, structured diagnostics, and high-fidelity terminal rendering.
    Governed by the Haskell Engineering Standard and implementing the Event Protocol v1
    and Visual Grammar v1 specifications.
license:            MIT
license-file:       LICENSE
author:             bombay boyz
maintainer:         259497327+Bombay-Boyz@users.noreply.github.com
copyright:          2026 bombay boyz
category:           Development
build-type:         Simple
extra-doc-files:
    README.md
    CHANGELOG.md

source-repository head
    type:     git
    location: https://github.com/Bombay-Boyz/buildr

flag dev
    description: Enable -Werror for development builds
    default:     False
    manual:      True

common warnings
    ghc-options:
      -Wall
      -Wcompat
      -Wincomplete-uni-patterns
      -Wincomplete-record-updates
      -Wmissing-export-lists
      -Wunused-imports
      -Wunused-top-binds
      -Wunused-local-binds
      -Wunused-matches
      -Wredundant-constraints
      -Wpartial-fields
      -Widentities
    if flag(dev)
      ghc-options: -Werror
    default-language:   GHC2021
    default-extensions:
      StrictData
      BangPatterns
      LambdaCase
      OverloadedStrings

library
    import:           warnings
    exposed-modules:
        Buildr.Benchmark
        Buildr.Cli
        Buildr.Config
        Buildr.Core
        Buildr.Editor
        Buildr.Error
        Buildr.Event
        Buildr.Grammar
        Buildr.Graph
        Buildr.Hinsight
        Buildr.History
        Buildr.Ipc
        Buildr.Model
        Buildr.Plan
        Buildr.Signal
        Buildr.Terminal
        Buildr.Theme
        Buildr.View
    hs-source-dirs:   src
    build-depends:
        base >=4.20 && <5,
        aeson >=2.0 && <2.4,
        async >=2.2 && <2.3,
        bytestring >=0.11 && <0.13,
        containers >=0.6 && <0.8,
        directory >=1.3 && <1.4,
        filepath >=1.4 && <1.6,
        network >=3.1 && <3.3,
        optparse-applicative >=0.18 && <0.20,
        process >=1.6 && <1.7,
        terminal-size >=0.3 && <0.4,
        text >=2.0 && <2.2,
        time >=1.11 && <1.15,
        unix >=2.8 && <2.9

executable buildr
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   app
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base,
        buildr

executable cabal-buildr
    import:           warnings
    main-is:          CabalMain.hs
    hs-source-dirs:   app
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base,
        buildr

executable buildr-ghc
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   wrapper
    ghc-options:      -threaded
    build-depends:
        base,
        buildr,
        async,
        network,
        process,
        text,
        unix,
        time

test-suite buildr-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    ghc-options:      -threaded
    build-depends:
        base,
        buildr,
        aeson,
        bytestring,
        containers,
        directory,
        filepath,
        process,
        terminal-size,
        QuickCheck >=2.14 && <2.20,
        text,
        time,
        unix
